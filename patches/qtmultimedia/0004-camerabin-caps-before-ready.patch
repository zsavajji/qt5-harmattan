+// Sets a capture caps property of camerabin, unless it holds these caps already. GStreamer 0.10
+// (Nokia's camerabin2 on the N9): once one was set in READY, the next PLAYING deadlocked in the
+// camera source. A change outside NULL is only noted there: load() applies it before READY.
+void CameraBinSession::setCaptureCaps(const char *property, GstCaps *caps)
+{
+    GstCaps *current = nullptr;
+    g_object_get(m_camerabin, property, &current, NULL);
+    const bool same = current && gst_caps_is_equal(current, caps);
+    if (current)
+        gst_caps_unref(current);
+    if (same)
+        return;
+#if !GST_CHECK_VERSION(1,0,0)
+    GstState state = GST_STATE_NULL;
+    gst_element_get_state(m_camerabin, &state, nullptr, 0);
+    if (state != GST_STATE_NULL) {
+        m_reloadBeforeStart = true;
+        return;
+    }
+#endif
+    g_object_set(m_camerabin, property, caps, NULL);
+}
