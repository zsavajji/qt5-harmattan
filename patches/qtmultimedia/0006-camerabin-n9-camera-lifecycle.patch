+// Takes camerabin to NULL. GStreamer 0.10 (the N9): subdevsrc2 creates Nokia's libomap3camd on
+// a task it starts in READY, and on the way to NULL deletes the library only if it is already
+// there: leaving READY during the creation leaked it, still holding its lock file, and the next
+// READY retried "libomap3camd is still in use" forever (the camera hung in StartingStatus).
+// Out of READY the pipeline passes PAUSED first: subdevsrc2 configures there, which waits for
+// the library. The bus is flushed meanwhile, as that PAUSED is not a state for the session.
+// Not once start() has asked for PLAYING: the library is there then, and a second PAUSED hung
+// in the source (after stop(), or after it failed to start).
+void CameraBinSession::setNullState()
+{
+    // The viewfinder gives its frames back first: Nokia's camera source lends its driver
+    // buffers and, on the way down, waits for all of them; VideoOutput kept the last one (only
+    // the GUI thread, busy here, lets go of it), so a reload while streaming hung. unload()
+    // already did this; the sink restarts the surface with the next caps.
+    if (m_viewfinderInterface)
+        m_viewfinderInterface->stopRenderer();
+#if !GST_CHECK_VERSION(1,0,0)
+    GstState state = GST_STATE_NULL;
+    gst_element_get_state(m_camerabin, &state, nullptr, 0);
+    const bool started = m_started;
+    m_started = false;
+    if (state == GST_STATE_READY && !started) {
+        GstBus *bus = gst_element_get_bus(m_camerabin);
+        gst_bus_set_flushing(bus, TRUE);
+        if (gst_element_set_state(m_camerabin, GST_STATE_PAUSED) == GST_STATE_CHANGE_ASYNC)
+            gst_element_get_state(m_camerabin, nullptr, nullptr, 5 * GST_SECOND);
+        gst_element_set_state(m_camerabin, GST_STATE_NULL);
+        gst_bus_set_flushing(bus, FALSE);
+        gst_object_unref(bus);
+        return;
+    }
+#endif
+    gst_element_set_state(m_camerabin, GST_STATE_NULL);
+}
+
