+void QGstreamerVideoRenderer::handleGLContext()
+{
+    if (m_surface) {
+        // Switch only to a texture sink that could be made: a switch reloads the user's
+        // pipeline (the camera's hung when reloaded while starting).
+        if (m_videoSink && !m_textureSink) {
+            if (GstElement *sink = createTextureSink()) {
+                resetSink(m_videoSink, sink);
+                m_textureSink = true;
+                emit sinkChanged();
+            }
+        }
+        // Only on a change: VideoOutput sets the property again (stopping the surface, for
+        // one), and every readyChanged restarts a waiting camera, which stops the surface.
+        const bool ready = isReady();
+        if (ready != m_reportedReady) {
+            m_reportedReady = ready;
+            emit readyChanged(ready);
+        }
+    }
+}
