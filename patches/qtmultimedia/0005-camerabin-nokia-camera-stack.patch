+bool QGstreamerVideoRenderer::isReady() const
+{
+    if (!m_surface)
+        return false;
+#if !GST_CHECK_VERSION(1,0,0)
+    // Harmattan: for the camera (CameraBinSession sets the property), when the texture sink is
+    // possible, ready once VideoOutput has its OpenGL context: the camera then starts once with
+    // its final sink instead of with the copying one, switched while starting (Nokia's camera
+    // source hung in that reload). Not for the player: resuming after a pause stalled.
+    if (property("_q_waitForGLContext").toBool() && textureSinkPossible()
+            && !m_surface->property("GLContext").value<QObject *>())
+        return false;
 #endif
+    return true;
+}
 
