@@ -0,0 +1,282 @@
+/****************************************************************************
+**
+** Copyright (C) 2026 Andrea Faggin
+**
+** Harmattan (N9) video frames from Nokia's gltexturesink, drawn without a copy.
+** Based on the egl videonode plugin: Copyright (C) 2016 The Qt Company Ltd.
+**
+** This file may be used under the terms of the GNU Lesser General Public License version 3,
+** or the GNU General Public License version 2 or 3, as the Qt Multimedia module it belongs to.
+**
+****************************************************************************/
+
+// gltexturesink (the phone's GStreamer 0.10, used by gsttools' QGstreamerVideoRenderer) keeps
+// the DSP-decoded frames as EGL images. A frame's handle is [sink, frame number]. As Qt Mobility's
+// QGstreamerGLTextureRenderer did, each rendering pass has the sink bind the frame to our
+// GL_TEXTURE_EXTERNAL_OES texture just before drawing, and gives it back behind a fence right
+// after (QQuickWindow::afterRendering): the sink produces the next frame only once it has the
+// previous one back, so holding a frame until the next one stalled playback. The interface
+// library has no headers in the SDK and isn't on every system, so it is loaded at run time.
+
+// Qt's headers before the EGL ones in ours, which bring Xlib's macros (KeyPress, None...).
+#include <QtGui/qopenglcontext.h>
+#include <QtMultimedia/qvideosurfaceformat.h>
+#include <QtQuick/qquickwindow.h>
+
+#include "qsgvideonode_harmattan.h"
+
+#include <GLES2/gl2ext.h>
+#include <dlfcn.h>
+
+QT_BEGIN_NAMESPACE
+
+// EGL_KHR_fence_sync: the SGX driver has it, the SDK's eglext.h (2011) doesn't declare it.
+#ifndef EGL_SYNC_FENCE_KHR
+#define EGL_SYNC_FENCE_KHR 0x30F9
+#endif
+typedef void *(*CreateSyncKHR)(EGLDisplay display, EGLenum type, const EGLint *attributes);
+
+static const QAbstractVideoBuffer::HandleType HarmattanTextureHandle =   // as in gsttools
+        QAbstractVideoBuffer::HandleType(QAbstractVideoBuffer::UserHandle + 0x4e39);
+
+namespace {
+struct VideoTexture // libgstmeegointerfaces-0.10: MeegoGstVideoTexture, and GObject references
+{
+    int (*acquireFrame)(void *sink, int frame) = nullptr;
+    int (*bindFrame)(void *sink, int target, int frame) = nullptr;
+    void (*releaseFrame)(void *sink, int frame, void *sync) = nullptr;
+    void *(*ref)(void *object) = nullptr;
+    void (*unref)(void *object) = nullptr;
+    CreateSyncKHR createSync = nullptr;
+    bool ok = false;
+};
+}
+
+static const VideoTexture &videoTexture()
+{
+    static const VideoTexture api = [] {
+        VideoTexture a;
+        void *meego = dlopen("libgstmeegointerfaces-0.10.so.0", RTLD_NOW | RTLD_GLOBAL);
+        void *gobject = dlopen("libgobject-2.0.so.0", RTLD_NOW | RTLD_GLOBAL);
+        if (meego && gobject) {
+            a.acquireFrame = reinterpret_cast<decltype(a.acquireFrame)>(dlsym(meego, "meego_gst_video_texture_acquire_frame"));
+            a.bindFrame = reinterpret_cast<decltype(a.bindFrame)>(dlsym(meego, "meego_gst_video_texture_bind_frame"));
+            a.releaseFrame = reinterpret_cast<decltype(a.releaseFrame)>(dlsym(meego, "meego_gst_video_texture_release_frame"));
+            a.ref = reinterpret_cast<decltype(a.ref)>(dlsym(gobject, "g_object_ref"));
+            a.unref = reinterpret_cast<decltype(a.unref)>(dlsym(gobject, "g_object_unref"));
+        }
+        a.createSync = reinterpret_cast<CreateSyncKHR>(eglGetProcAddress("eglCreateSyncKHR"));
+        a.ok = a.acquireFrame && a.bindFrame && a.releaseFrame && a.ref && a.unref && a.createSync;
+        return a;
+    }();
+    return api;
+}
+
+namespace {
+struct BoundFrame { void *sink; int frame; GLuint texture; };
+}
+static QVector<BoundFrame> boundFrames;   // this rendering pass's, in the rendering thread
+
+static void releaseBoundFrames()
+{
+    const VideoTexture &api = videoTexture();
+    // The sink waits on the fence before reusing a frame's buffer: the GPU may still be
+    // drawing it. Without a current context (destruction) there is none to wait for.
+    EGLDisplay display = eglGetCurrentDisplay();
+    for (const BoundFrame &b : qAsConst(boundFrames)) {
+        glBindTexture(GL_TEXTURE_EXTERNAL_OES, b.texture);
+        api.bindFrame(b.sink, GL_TEXTURE_EXTERNAL_OES, -1);
+        void *sync = display != EGL_NO_DISPLAY ? api.createSync(display, EGL_SYNC_FENCE_KHR, nullptr) : nullptr;
+        api.releaseFrame(b.sink, b.frame, sync);
+        api.unref(b.sink);
+    }
+    boundFrames.clear();
+}
+
+// Frames go back after each rendering pass of the window being rendered.
+static void releaseAfterRendering()
+{
+    QOpenGLContext *context = QOpenGLContext::currentContext();
+    QSurface *surface = context ? context->surface() : nullptr;
+    if (!surface || surface->surfaceClass() != QSurface::Window)
+        return;
+    auto *window = qobject_cast<QQuickWindow *>(static_cast<QWindow *>(surface));
+    if (window && !window->property("_q_harmattanVideo").toBool()) {
+        window->setProperty("_q_harmattanVideo", true);
+        QObject::connect(window, &QQuickWindow::afterRendering, releaseBoundFrames); // direct
+    }
+}
+
+class QSGVideoMaterial_HarmattanShader : public QSGMaterialShader
+{
+public:
+    void updateState(const RenderState &state, QSGMaterial *newEffect, QSGMaterial *oldEffect) override;
+    char const *const *attributeNames() const override;
+
+    static QSGMaterialType type;
+
+protected:
+    void initialize() override;
+    const char *vertexShader() const override;
+    const char *fragmentShader() const override;
+
+private:
+    int id_matrix;
+    int id_opacity;
+    int id_texture;
+};
+
+QSGMaterialType QSGVideoMaterial_HarmattanShader::type;
+
+void QSGVideoMaterial_HarmattanShader::updateState(
+        const RenderState &state, QSGMaterial *newEffect, QSGMaterial *oldEffect)
+{
+    auto *material = static_cast<QSGVideoMaterial_Harmattan *>(newEffect);
+    if (!oldEffect)
+        program()->setUniformValue(id_texture, 0);
+    if (state.isMatrixDirty())
+        program()->setUniformValue(id_matrix, state.combinedMatrix());
+    if (state.isOpacityDirty())
+        program()->setUniformValue(id_opacity, state.opacity());
+
+    glActiveTexture(GL_TEXTURE0);
+    material->bindFrame();
+}
+
+char const *const *QSGVideoMaterial_HarmattanShader::attributeNames() const
+{
+    static char const *const attr[] = { "position", "texcoord", nullptr };
+    return attr;
+}
+
+void QSGVideoMaterial_HarmattanShader::initialize()
+{
+    id_matrix = program()->uniformLocation("matrix");
+    id_opacity = program()->uniformLocation("opacity");
+    id_texture = program()->uniformLocation("texture");
+}
+
+const char *QSGVideoMaterial_HarmattanShader::vertexShader() const
+{
+    return  "\n uniform highp mat4 matrix;"
+            "\n attribute highp vec4 position;"
+            "\n attribute highp vec2 texcoord;"
+            "\n varying highp vec2 frag_tx;"
+            "\n void main(void)"
+            "\n {"
+            "\n     gl_Position = matrix * position;"
+            "\n     frag_tx = texcoord;"
+            "\n }";
+}
+
+const char *QSGVideoMaterial_HarmattanShader::fragmentShader() const
+{
+    return  "\n #extension GL_OES_EGL_image_external : require"
+            "\n uniform samplerExternalOES texture;"
+            "\n uniform lowp float opacity;"
+            "\n varying highp vec2 frag_tx;"
+            "\n void main(void)"
+            "\n {"
+            "\n     gl_FragColor = texture2D(texture, frag_tx.st) * opacity;"
+            "\n }";
+}
+
+QSGVideoMaterial_Harmattan::~QSGVideoMaterial_Harmattan()
+{
+    setFrame(nullptr, -1);
+    if (m_textureId)
+        glDeleteTextures(1, &m_textureId);
+}
+
+QSGMaterialShader *QSGVideoMaterial_Harmattan::createShader() const
+{
+    return new QSGVideoMaterial_HarmattanShader;
+}
+
+QSGMaterialType *QSGVideoMaterial_Harmattan::type() const
+{
+    return &QSGVideoMaterial_HarmattanShader::type;
+}
+
+int QSGVideoMaterial_Harmattan::compare(const QSGMaterial *other) const
+{
+    return m_textureId - static_cast<const QSGVideoMaterial_Harmattan *>(other)->m_textureId;
+}
+
+// While syncing: the frame the next rendering passes draw.
+void QSGVideoMaterial_Harmattan::setFrame(void *sink, int frame)
+{
+    const VideoTexture &api = videoTexture();
+    if (sink)
+        api.ref(sink);
+    if (m_sink)
+        api.unref(m_sink);
+    m_sink = sink;
+    m_frame = frame;
+}
+
+// While rendering, just before drawing: given back after this pass (releaseBoundFrames()). A
+// repaint without a new frame binds the same one again; one the sink has reused in the
+// meantime can't be acquired, and the texture stays empty until the next frame.
+void QSGVideoMaterial_Harmattan::bindFrame()
+{
+    if (!m_textureId) {
+        glGenTextures(1, &m_textureId);
+        glBindTexture(GL_TEXTURE_EXTERNAL_OES, m_textureId);
+        glTexParameterf(GL_TEXTURE_EXTERNAL_OES, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+        glTexParameterf(GL_TEXTURE_EXTERNAL_OES, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+        glTexParameteri(GL_TEXTURE_EXTERNAL_OES, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+        glTexParameteri(GL_TEXTURE_EXTERNAL_OES, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    }
+    glBindTexture(GL_TEXTURE_EXTERNAL_OES, m_textureId);
+    for (const BoundFrame &b : qAsConst(boundFrames)) {
+        if (b.texture == m_textureId)
+            return;   // already bound in this pass
+    }
+    const VideoTexture &api = videoTexture();
+    if (m_sink && api.acquireFrame(m_sink, m_frame) && api.bindFrame(m_sink, GL_TEXTURE_EXTERNAL_OES, m_frame)) {
+        boundFrames.append({ api.ref(m_sink), m_frame, m_textureId });
+        releaseAfterRendering();
+    }
+}
+
+QSGVideoNode_Harmattan::QSGVideoNode_Harmattan(const QVideoSurfaceFormat &format)
+    : m_pixelFormat(format.pixelFormat())
+{
+    setMaterial(&m_material);
+}
+
+void QSGVideoNode_Harmattan::setCurrentFrame(const QVideoFrame &frame, FrameFlags)
+{
+    const QVariantList handle = frame.handle().toList();
+    if (handle.size() == 2)
+        m_material.setFrame(handle.at(0).value<void *>(), handle.at(1).toInt());
+    markDirty(DirtyMaterial);
+}
+
+QVideoFrame::PixelFormat QSGVideoNode_Harmattan::pixelFormat() const
+{
+    return m_pixelFormat;
+}
+
+QAbstractVideoBuffer::HandleType QSGVideoNode_Harmattan::handleType() const
+{
+    return HarmattanTextureHandle;
+}
+
+QList<QVideoFrame::PixelFormat> QSGVideoNodeFactory_Harmattan::supportedPixelFormats(
+        QAbstractVideoBuffer::HandleType handleType) const
+{
+    if (handleType != HarmattanTextureHandle || !videoTexture().ok)
+        return QList<QVideoFrame::PixelFormat>();
+    return QList<QVideoFrame::PixelFormat>() << QVideoFrame::Format_RGB32;
+}
+
+QSGVideoNode *QSGVideoNodeFactory_Harmattan::createNode(const QVideoSurfaceFormat &format)
+{
+    return format.handleType() == HarmattanTextureHandle && videoTexture().ok
+            ? new QSGVideoNode_Harmattan(format)
+            : nullptr;
+}
+
+QT_END_NAMESPACE
