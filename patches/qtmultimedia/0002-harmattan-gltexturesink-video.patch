+// Harmattan (N9): Nokia's gltexturesink hands the DSP-decoded frames over as EGL images, which
+// the "harmattan" videonode plugin binds to a GL_TEXTURE_EXTERNAL_OES texture: no copy of the
+// frames, which QVideoSurfaceGstSink made into textures at full CPU. A frame's handle is
+// [sink, frame number]; the handle type must match the plugin's.
+static const QAbstractVideoBuffer::HandleType HarmattanTextureHandle =
+        QAbstractVideoBuffer::HandleType(QAbstractVideoBuffer::UserHandle + 0x4e39);
+
+class QHarmattanTextureBuffer : public QAbstractVideoBuffer
+{
+public:
+    QHarmattanTextureBuffer(GstElement *sink, int frame)
+        : QAbstractVideoBuffer(HarmattanTextureHandle), m_sink(sink), m_frame(frame) {}
+
+    MapMode mapMode() const override { return NotMapped; }
+    uchar *map(MapMode, int *, int *) override { return nullptr; }
+    void unmap() override {}
+    QVariant handle() const override
+    {
+        return QVariantList() << QVariant::fromValue<void *>(m_sink) << m_frame;
+    }
+
+private:
+    GstElement *m_sink;
+    int m_frame;
+};
+#endif
