+            && static_cast<QDynamicPropertyChangeEvent *>(event)->propertyName() == "GLContext"
+            && m_videoSink && !m_textureSink) {
+        resetSink(m_videoSink);
+        emit sinkChanged();
+    }
+    return false;
+}
