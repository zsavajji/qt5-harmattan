+#ifndef HARMATTANVIDEONODE_H
+#define HARMATTANVIDEONODE_H
+
+#include <private/qsgvideonode_p.h>
+
+#include <QSGMaterial>
+
+#include <EGL/egl.h>
+#include <EGL/eglext.h>
+
+#ifdef Bool
+#  undef Bool
+#endif
+#ifdef None
+#  undef None
+#endif
+
+QT_BEGIN_NAMESPACE
+
+class QSGVideoMaterial_Harmattan : public QSGMaterial
+{
+public:
+    ~QSGVideoMaterial_Harmattan();
+
+    QSGMaterialShader *createShader() const override;
+    QSGMaterialType *type() const override;
+    int compare(const QSGMaterial *other) const override;
+
+    void setFrame(void *sink, int frame);
+    void bindFrame();
+
+private:
+    void *m_sink = nullptr;
+    int m_frame = -1;
+    GLuint m_textureId = 0;
+};
+
