+GstElement *QGstreamerVideoRenderer::createTextureSink()
+{
+    // The surface takes these frames only with the videonode plugin, and gives its OpenGL
+    // context once VideoOutput has rendered (eventFilter() then switches sinks). The sink hands
+    // frames over only from the overlay framebuffer's memory (the DSP decodes into it), which is
+    // root:video: apps get it with Aegis' GRP::video, others keep the copying sink.
+    if (m_surface->supportedPixelFormats(HarmattanTextureHandle).isEmpty()
+            || access("/dev/fb2", R_OK | W_OK) != 0)
+        return nullptr;
+    auto *context = qobject_cast<QOpenGLContext *>(m_surface->property("GLContext").value<QObject *>());
+    if (!context || !context->nativeHandle().canConvert<QEGLNativeContext>())
+        return nullptr;
+    const auto egl = context->nativeHandle().value<QEGLNativeContext>();
+    // Qt's own Xlib display: the xcb plugin calls XInitThreads(), and the sink uses it from the
+    // streaming thread.
+    void *display = QGuiApplication::platformNativeInterface()->nativeResourceForIntegration("display");
+    if (!display)
+        return nullptr;
+    GstElement *sink = gst_element_factory_make("gltexturesink", nullptr);
+    if (!sink)
+        return nullptr;
+    g_object_set(G_OBJECT(sink),
+                 "x-display", display,
+                 "egl-display", egl.display(),
+                 "egl-context", egl.context(),
+                 "render-mode", "video-texture",
+                 "use-framebuffer-memory", TRUE,
+                 nullptr);
+    g_signal_connect(G_OBJECT(sink), "frame-ready", G_CALLBACK(handleFrameReady), this);
+    return sink;
+}
+
+// The sink's streaming thread: present the frame on the GUI thread, and wait until it has been,
+// as Qt Mobility did: at most 60 ms (1-2 frames), so a busy or stopping GUI thread drops frames
+// instead of deadlocking.
+void QGstreamerVideoRenderer::handleFrameReady(GstElement *, gint frame, gpointer data)
+{
+    auto *self = static_cast<QGstreamerVideoRenderer *>(data);
+    QMutexLocker locker(&self->m_mutex);
+    QMetaObject::invokeMethod(self, "presentTextureFrame", Qt::QueuedConnection, Q_ARG(int, frame));
+    self->m_presented.wait(&self->m_mutex, 60);
+}
+
+void QGstreamerVideoRenderer::presentTextureFrame(int frame)
+{
+    QMutexLocker locker(&m_mutex);
+    if (m_surface && m_videoSink && m_textureSink) {
+        if (m_surface->isActive() && m_surface->surfaceFormat().handleType() != HarmattanTextureHandle)
+            m_surface->stop();
+        if (!m_surface->isActive()) {
+            QSize size;
+            GstPad *pad = gst_element_get_static_pad(m_videoSink, "sink");
+            if (GstCaps *caps = gst_pad_get_negotiated_caps(pad)) {
+                size = QGstUtils::capsCorrectedResolution(caps);
+                gst_caps_unref(caps);
+            }
+            gst_object_unref(GST_OBJECT(pad));
+            m_surface->start(QVideoSurfaceFormat(size, QVideoFrame::Format_RGB32, HarmattanTextureHandle));
+        }
+        if (m_surface->isActive()) {
+            m_surface->present(QVideoFrame(new QHarmattanTextureBuffer(m_videoSink, frame),
+                                           m_surface->surfaceFormat().frameSize(),
+                                           QVideoFrame::Format_RGB32));
+        }
+    }
+    m_presented.wakeAll();
+}
+
+// VideoOutput gives the surface its OpenGL context after its first rendering, which can be after
+// the pipeline has its sink: then switch to the texture sink.
+bool QGstreamerVideoRenderer::eventFilter(QObject *watched, QEvent *event)
+{
