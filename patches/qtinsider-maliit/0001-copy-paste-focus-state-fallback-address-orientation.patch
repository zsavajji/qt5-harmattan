+// Harmattan: the 0.81 server (the N9's meego-im-uiserver) calls copy and paste from the
+// keyboard's buttons; Maliit 0.99 dropped them. Send the platform shortcut to the focus object.
+static void sendShortcut(QKeySequence::StandardKey key)
+{
+    QObject *target = QGuiApplication::focusObject();
+    const QList<QKeySequence> bindings = QKeySequence::keyBindings(key);
+    if (!target || bindings.isEmpty())
+        return;
+    const int combined = bindings.first()[0];
+    const Qt::Key k = Qt::Key(combined & ~Qt::KeyboardModifierMask);
+    const Qt::KeyboardModifiers modifiers = Qt::KeyboardModifiers(combined & Qt::KeyboardModifierMask);
+    QKeyEvent press(QEvent::KeyPress, k, modifiers);
+    QKeyEvent release(QEvent::KeyRelease, k, modifiers);
+    QCoreApplication::sendEvent(target, &press);
+    QCoreApplication::sendEvent(target, &release);
+}
+
+void QMaliitInputcontext1Adaptor::copy()
+{
+    sendShortcut(QKeySequence::Copy);
+}
+
+void QMaliitInputcontext1Adaptor::paste()
+{
+    sendShortcut(QKeySequence::Paste);
+}
