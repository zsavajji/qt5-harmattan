+private:
+    // Harmattan: the SGX driver ignores eglSwapInterval, and a fullscreen window without
+    // decorations, which mcompositor doesn't composite, swaps without waiting for vsync: Qt
+    // Quick then renders ~120 fps for a 60 Hz panel. So swaps are paced to the refresh rate
+    // here; when the compositor already throttles, the wait comes out as zero. This removes
+    // the wasted frames, not tearing: true vsync would need /dev/fb0, which apps can't open.
+    void paceSwap(qreal refreshRate)
+    {
+        const qint64 intervalNs = qint64(1e9 / (refreshRate > 0 ? refreshRate : 60));
+        if (m_lastSwap.isValid()) {
+            const qint64 left = intervalNs - m_lastSwap.nsecsElapsed();
+            if (left > 0)
+                QThread::usleep(left / 1000);
+        }
+        m_lastSwap.start();
+    }
+
+    QElapsedTimer m_lastSwap;
