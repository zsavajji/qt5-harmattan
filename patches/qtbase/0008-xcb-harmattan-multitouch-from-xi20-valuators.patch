     void xi2SetupDevices();
+    // Harmattan: the N9's X server speaks XInput 2.0 (no touch events) and reports every
+    // finger of its touchscreen in ordinary pointer events, as repeated groups of "Abs MT"
+    // valuators, each group ending with the finger's tracking id. Decoded into touch events
+    // in xi2HandleHarmattanTouch(); from Qt 5.0-5.3's qxcbconnection_maemo.cpp.
+    struct HarmattanTouch {
+        int deviceId = -1;
+        struct Valuator {
+            int number;
+            int label; // QXcbAtom::AbsMT*
+            double min;
+            double max;
+        };
+        QVector<Valuator> valuators; // by valuator number
+        QTouchDevice *device = nullptr;
+        QHash<int, QWindowSystemInterface::TouchPoint> points; // fingers down, by tracking id
+    };
+    HarmattanTouch m_harmattanTouch;
+    void xi2SetupHarmattanTouch(void *info);
+    void xi2HandleHarmattanTouch(void *xiDevEvent, QXcbWindow *platformWindow);
+
     struct TouchDeviceData {
         QTouchDevice *qtTouchDevice = nullptr;
         QHash<int, QWindowSystemInterface::TouchPoint> touchPoints;
