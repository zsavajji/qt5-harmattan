+// Harmattan: a minimized window stays mapped, because the home screen shows it in the
+// task switcher. It counts as exposed only while its thumbnail is on screen, which the home
+// screen signals with _MEEGOTOUCH_VISIBLE_IN_SWITCHER; otherwise Qt Quick would keep
+// rendering in the background.
 bool QXcbWindow::isExposed() const
 {
-    return m_mapped;
+    return m_mapped && (!m_minimized || m_visibleInSwitcher);
+}
+
+void QXcbWindow::updateHarmattanExposure(bool wasExposed)
+{
+    const bool exposed = isExposed();
+    if (exposed == wasExposed)
+        return;
+    QWindowSystemInterface::handleExposeEvent(window(), exposed ? QRegion(QRect(QPoint(), geometry().size()))
+                                                                : QRegion());
+}
+
+// Harmattan: mcompositor and its swipe extension read gestures relative to
+// _MEEGOTOUCH_ORIENTATION_ANGLE (0 landscape, 270 portrait, 180 and 90 inverted). Without it
+// a portrait app is taken for landscape, and a side swipe becomes a swipe down, which
+// closes the app instead of minimizing it.
+void QXcbWindow::handleContentOrientationChange(Qt::ScreenOrientation orientation)
+{
+    static const xcb_atom_t angleAtom = connection()->internAtom("_MEEGOTOUCH_ORIENTATION_ANGLE");
+    quint32 angle = 0;
+    switch (orientation) {
+    case Qt::PortraitOrientation: angle = 270; break;
+    case Qt::InvertedLandscapeOrientation: angle = 180; break;
+    case Qt::InvertedPortraitOrientation: angle = 90; break;
+    default: angle = 0; break; // landscape, the display's native orientation
+    }
+    xcb_change_property(xcb_connection(), XCB_PROP_MODE_REPLACE, m_window, angleAtom,
+                        XCB_ATOM_CARDINAL, 32, 1, &angle);
+    xcb_flush(xcb_connection());
 }
 
