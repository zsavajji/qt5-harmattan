 bool QXcbEglIntegration::initialize(QXcbConnection *connection)
 {
     m_connection = connection;
 
+#if QT_CONFIG(xcb_xlib)
+    // Harmattan: EGL gets its own Xlib connection, whose events Xlib owns, as under Qt 4. The
+    // SGX driver waits for its DRI2 events (swap complete, buffer invalidation) by reading
+    // them through Xlib. On Qt's connection XCB owns the events, so they could only reach the
+    // driver if the GUI thread forwarded them, which it can't while it is inside
+    // eglSwapBuffers: rendering stalled for about 30 s around minimize and lock, and deadlocked
+    // with a render thread. X resources are shared, so Qt's windows work on this connection.
+    Display *qtDisplay = static_cast<Display *>(connection->xlib_display());
+    if (Display *eglDisplay = XOpenDisplay(DisplayString(qtDisplay))) {
+        m_eglXDisplay = eglDisplay;
+        // Nobody else reads this connection: drop its events once the driver's hooks have seen them.
+        m_eglXNotifier = new QSocketNotifier(ConnectionNumber(eglDisplay), QSocketNotifier::Read);
+        QObject::connect(m_eglXNotifier, &QSocketNotifier::activated, [eglDisplay] {
+            while (XPending(eglDisplay)) {
+                XEvent event;
+                XNextEvent(eglDisplay, &event);
+            }
+        });
+    } else {
+        qWarning("Could not open a separate X connection for EGL, using Qt's");
+    }
+#endif
+
     const char *extensions = eglQueryString(EGL_NO_DISPLAY, EGL_EXTENSIONS);
 
     if (extensions && strstr(extensions, "EGL_EXT_platform_x11")) {
@@ -116,7 +145,7 @@
