@@ -0,0 +1,44 @@
+/****************************************************************************
+**
+** Copyright (C) 2026 Andrea Faggin
+**
+** Harmattan device orientation for the xcb platform plugin (qt5-harmattan).
+** Licensed under the LGPL 3 / GPL 2 or 3, as the rest of qtbase.
+**
+****************************************************************************/
+
+#ifndef QXCBHARMATTANORIENTATION_H
+#define QXCBHARMATTANORIENTATION_H
+
+#include <QtCore/QObject>
+#include <QtCore/QVariantList>
+
+QT_BEGIN_NAMESPACE
+
+class QDBusPendingCallWatcher;
+
+// Harmattan: the device orientation, reported as the primary QScreen's orientation. It comes
+// from sensord's ContextKit property Screen.TopEdge on the system bus, which the Qt 4
+// components also read; their ContextKit library is Qt 4, so this talks D-Bus directly.
+// The sensor is subscribed only while the application is active.
+class QXcbHarmattanOrientation : public QObject
+{
+    Q_OBJECT
+public:
+    QXcbHarmattanOrientation();
+
+private Q_SLOTS:
+    void valueChanged(const QVariantList &values, qulonglong timestamp);
+    void replyFinished(QDBusPendingCallWatcher *watcher);
+    void applicationStateChanged(Qt::ApplicationState state);
+
+private:
+    void call(const QString &method);
+    void apply(const QVariantList &values);
+    bool m_subscribed = false;
+    bool m_maskSet = false;
+};
+
+QT_END_NAMESPACE
+
+#endif
