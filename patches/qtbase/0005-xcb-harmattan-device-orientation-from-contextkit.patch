@@ -0,0 +1,105 @@
+/****************************************************************************
+**
+** Copyright (C) 2026 Andrea Faggin
+**
+** Harmattan device orientation for the xcb platform plugin (qt5-harmattan).
+** Licensed under the LGPL 3 / GPL 2 or 3, as the rest of qtbase.
+**
+****************************************************************************/
+
+#include "qxcbharmattanorientation.h"
+
+#include <QtDBus/QDBusConnection>
+#include <QtDBus/QDBusMessage>
+#include <QtDBus/QDBusMetaType>
+#include <QtDBus/QDBusPendingCallWatcher>
+#include <QtDBus/QDBusVariant>
+#include <QtGui/QGuiApplication>
+#include <QtGui/QScreen>
+#include <qpa/qwindowsysteminterface.h>
+
+QT_BEGIN_NAMESPACE
+
+static const char service[] = "com.nokia.SensorService";
+static const char path[] = "/org/maemo/contextkit/Screen/TopEdge";
+static const char interface[] = "org.maemo.contextkit.Property";
+
+QXcbHarmattanOrientation::QXcbHarmattanOrientation()
+{
+    // ValueChanged(av values, t timestamp)
+    QDBusConnection::systemBus().connect(QLatin1String(service), QLatin1String(path), QLatin1String(interface),
+                                         QStringLiteral("ValueChanged"), this,
+                                         SLOT(valueChanged(QVariantList,qulonglong)));
+    connect(qGuiApp, &QGuiApplication::applicationStateChanged,
+            this, &QXcbHarmattanOrientation::applicationStateChanged);
+    call(QStringLiteral("Get")); // the orientation to start with
+}
+
+void QXcbHarmattanOrientation::call(const QString &method)
+{
+    const QDBusMessage message = QDBusMessage::createMethodCall(QLatin1String(service), QLatin1String(path),
+                                                                QLatin1String(interface), method);
+    auto *watcher = new QDBusPendingCallWatcher(QDBusConnection::systemBus().asyncCall(message), this);
+    connect(watcher, &QDBusPendingCallWatcher::finished, this, &QXcbHarmattanOrientation::replyFinished);
+}
+
+void QXcbHarmattanOrientation::replyFinished(QDBusPendingCallWatcher *watcher)
+{
+    watcher->deleteLater();
+    const QDBusMessage reply = watcher->reply();
+    // Get and Subscribe answer (av values, t timestamp); Unsubscribe answers nothing.
+    if (reply.type() == QDBusMessage::ReplyMessage && !reply.arguments().isEmpty())
+        apply(qdbus_cast<QVariantList>(reply.arguments().at(0)));
+}
+
+void QXcbHarmattanOrientation::valueChanged(const QVariantList &values, qulonglong)
+{
+    apply(values);
+}
+
+void QXcbHarmattanOrientation::applicationStateChanged(Qt::ApplicationState state)
+{
+    const bool subscribe = state == Qt::ApplicationActive;
+    if (subscribe == m_subscribed)
+        return;
+    m_subscribed = subscribe;
+    call(subscribe ? QStringLiteral("Subscribe") : QStringLiteral("Unsubscribe"));
+}
+
+// Screen.TopEdge names the edge of the (natively landscape) display that is up:
+// "top" landscape, "left" portrait, "bottom" landscape inverted, "right" portrait inverted.
+void QXcbHarmattanOrientation::apply(const QVariantList &values)
+{
+    if (values.isEmpty())
+        return; // no value yet
+    QVariant value = values.first();
+    if (value.userType() == qMetaTypeId<QDBusVariant>())
+        value = value.value<QDBusVariant>().variant();
+    const QString edge = value.toString();
+
+    Qt::ScreenOrientation orientation;
+    if (edge == QLatin1String("top"))
+        orientation = Qt::LandscapeOrientation;
+    else if (edge == QLatin1String("left"))
+        orientation = Qt::PortraitOrientation;
+    else if (edge == QLatin1String("bottom"))
+        orientation = Qt::InvertedLandscapeOrientation;
+    else if (edge == QLatin1String("right"))
+        orientation = Qt::InvertedPortraitOrientation;
+    else
+        return;
+
+    QScreen *screen = QGuiApplication::primaryScreen();
+    if (!screen)
+        return;
+    if (!m_maskSet) {
+        // Qt 5 emits QScreen::orientationChanged only for orientations in this mask, which
+        // defaults to none (Qt 6 dropped it). Every app on a phone wants the signal.
+        screen->setOrientationUpdateMask(Qt::PortraitOrientation | Qt::LandscapeOrientation
+                                         | Qt::InvertedPortraitOrientation | Qt::InvertedLandscapeOrientation);
+        m_maskSet = true;
+    }
+    QWindowSystemInterface::handleScreenOrientationChange(screen, orientation);
+}
+
+QT_END_NAMESPACE
