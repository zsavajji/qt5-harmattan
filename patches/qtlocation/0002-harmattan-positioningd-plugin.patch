+/****************************************************************************
+**
+** Copyright (C) 2026 Andrea Faggin
+**
+** Harmattan (N9) positions and satellites from Nokia's positioningd, over the session bus.
+** The protocol and the sources' behaviour follow Qt Mobility's maemo backend
+** (dbuscomm_maemo.cpp, qgeopositioninfosource_maemo.cpp: Copyright (C) 2013 Digia Plc).
+**
+** This file may be used under the terms of the GNU Lesser General Public License version 3,
+** or the GNU General Public License version 2 or 3, as the Qt Positioning module it belongs to.
+**
+****************************************************************************/
+
+#ifndef POSITIONINGD_H
+#define POSITIONINGD_H
+
+#include <QtCore/QTimer>
+#include <QtDBus/QDBusContext>
+#include <QtPositioning/QGeoPositionInfoSource>
+#include <QtPositioning/QGeoPositionInfoSourceFactory>
+#include <QtPositioning/QGeoSatelliteInfoSource>
+
+QT_BEGIN_NAMESPACE
+
+// One listener registered with positioningd (registerListener): the daemon calls the slots
+// below on our own service and path. Needs Aegis' Location credential, or every call to the
+// daemon is AccessDenied.
+class Positioningd : public QObject, protected QDBusContext
+{
+    Q_OBJECT
+    Q_CLASSINFO("D-Bus Interface", "com.nokia.qlocation.updates")
+
+public:
+    enum Command { Start = 1, Stop = 2, SetMethods = 4, SetInterval = 8, SatStart = 16, SatStop = 32 };
+
+    explicit Positioningd(QObject *parent);
+    ~Positioningd() override;
+    bool configure(int command, int method = 0, int interval = 0);
+    QGeoPositionInfo latestPosition(bool satelliteOnly);
+
+    bool registered = false;
+    bool accessDenied = false;
+    quint32 methods = 0;
+    int minimumInterval = 1000;
+
+public Q_SLOTS:
+    Q_NOREPLY void positionUpdate(const QByteArray &update);
+    Q_NOREPLY void satellitesInViewUpdate(const QByteArray &update);
+    Q_NOREPLY void satellitesInUseUpdate(const QByteArray &update);
+    Q_NOREPLY void currentSettings(quint32 newMethods, quint32 interval);
+
+Q_SIGNALS:
+    void position(const QGeoPositionInfo &update);
+    void satellitesInView(const QList<QGeoSatelliteInfo> &satellites);
+    void satellitesInUse(const QList<QGeoSatelliteInfo> &satellites);
+    void settingsChanged();
+    void restarted(); // registered again with a new daemon: sessions need their commands again
+
+private:
+    bool registerListener();
+    bool fromDaemon() const;
+    QString m_service;
+    QString m_path;
+    QString m_daemon; // positioningd's unique bus name
+    int m_id = -1;
+};
+
+class QGeoPositionInfoSourcePositioningd : public QGeoPositionInfoSource
+{
+    Q_OBJECT
+
+public:
+    explicit QGeoPositionInfoSourcePositioningd(QObject *parent);
+    ~QGeoPositionInfoSourcePositioningd() override;
+
+    void setUpdateInterval(int msec) override;
+    void setPreferredPositioningMethods(PositioningMethods methods) override;
+    QGeoPositionInfo lastKnownPosition(bool fromSatellitePositioningMethodsOnly = false) const override;
+    PositioningMethods supportedPositioningMethods() const override;
+    int minimumUpdateInterval() const override;
+    Error error() const override;
+
+public Q_SLOTS:
+    void startUpdates() override;
+    void stopUpdates() override;
+    void requestUpdate(int timeout = 0) override;
+
+private:
+    bool available();
+    void newPosition(const QGeoPositionInfo &update);
+    void finishRequest();
+
+    Positioningd *m_daemon;
+    QTimer m_requestTimer;
+    bool m_running = false;
+    bool m_lostFix = false;
+    Error m_error = NoError;
+};
+
+class QGeoSatelliteInfoSourcePositioningd : public QGeoSatelliteInfoSource
+{
+    Q_OBJECT
+
+public:
+    explicit QGeoSatelliteInfoSourcePositioningd(QObject *parent);
+    ~QGeoSatelliteInfoSourcePositioningd() override;
+
+    int minimumUpdateInterval() const override;
+    Error error() const override;
+
+public Q_SLOTS:
+    void startUpdates() override;
+    void stopUpdates() override;
+    void requestUpdate(int timeout = 0) override;
+
+private:
+    bool available();
+    void finishRequest();
+
+    Positioningd *m_daemon;
+    QTimer m_requestTimer;
+    bool m_running = false;
+    bool m_seenInView = false;
+    Error m_error = NoError;
+};
+
+class QGeoPositionInfoSourceFactoryPositioningd : public QObject, public QGeoPositionInfoSourceFactory
+{
+    Q_OBJECT
+    Q_PLUGIN_METADATA(IID "org.qt-project.qt.position.sourcefactory/5.0" FILE "plugin.json")
+    Q_INTERFACES(QGeoPositionInfoSourceFactory)
+
+public:
+    QGeoPositionInfoSource *positionInfoSource(QObject *parent) override;
+    QGeoSatelliteInfoSource *satelliteInfoSource(QObject *parent) override;
+    QGeoAreaMonitorSource *areaMonitor(QObject *parent) override;
+};
+
+QT_END_NAMESPACE
+
+#endif // POSITIONINGD_H
