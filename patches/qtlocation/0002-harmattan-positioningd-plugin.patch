+**
+** Harmattan (N9) positions and satellites from Nokia's positioningd, over the session bus.
+** The protocol and the sources' behaviour follow Qt Mobility's maemo backend
+** (dbuscomm_maemo.cpp, qgeopositioninfosource_maemo.cpp: Copyright (C) 2013 Digia Plc).
+**
+** This file may be used under the terms of the GNU Lesser General Public License version 3,
+** or the GNU General Public License version 2 or 3, as the Qt Positioning module it belongs to.
+**
+****************************************************************************/
+
+#include "positioningd.h"
+
+#include <QtCore/QDataStream>
+#include <QtCore/QLoggingCategory>
+#include <QtCore/QUuid>
+#include <QtDBus/QDBusConnection>
+#include <QtDBus/QDBusMessage>
+#include <QtDBus/QDBusServiceWatcher>
+
+Q_LOGGING_CATEGORY(lcPositioningd, "qt.positioning.positioningd")
+
+QT_BEGIN_NAMESPACE
+
+static const QString Daemon = QStringLiteral("com.nokia.positioningd.client"); // also its interface
+static const QString DaemonPath = QStringLiteral("/com/nokia/positioningd/client");
+static const int DefaultTimeout = 120000; // requestUpdate(0): a cold GPS start
+
+// positioningd serializes Qt Mobility's types with Qt 4.7's QDataStream (version Qt_4_6).
+// QGeoPositionInfo has the same fields in Qt 5 (timestamp, coordinate, attributes).
+static QGeoPositionInfo positionInfo(const QByteArray &data)
+{
+    QDataStream s(data);
+    s.setVersion(QDataStream::Qt_4_6);
+    QGeoPositionInfo info;
+    s >> info;
+    return info;
+}
+
+// Qt Mobility's QGeoSatelliteInfo: PRN, signal strength, then the attributes (Qt 5's differs).
+static QList<QGeoSatelliteInfo> satellites(const QByteArray &data)
+{
+    QDataStream s(data);
+    s.setVersion(QDataStream::Qt_4_6);
+    quint32 n = 0;
+    s >> n;
+    QList<QGeoSatelliteInfo> list;
+    while (n-- && s.status() == QDataStream::Ok) {
+        int prn = 0, signal = 0;
+        QHash<int, double> attributes;
+        s >> prn >> signal >> attributes;
+        QGeoSatelliteInfo info;
+        info.setSatelliteSystem(QGeoSatelliteInfo::GPS);
+        info.setSatelliteIdentifier(prn);
+        info.setSignalStrength(signal);
+        for (auto a = attributes.cbegin(); a != attributes.cend(); ++a)
+            info.setAttribute(QGeoSatelliteInfo::Attribute(a.key()), a.value());
+        list.append(info);
+    }
+    return list;
+}
+
+static QDBusMessage callDaemon(const QString &method, const QVariantList &args)
+{
+    QDBusMessage call = QDBusMessage::createMethodCall(Daemon, DaemonPath, Daemon, method);
+    call.setArguments(args);
+    QDBusMessage reply = QDBusConnection::sessionBus().call(call);
+    if (reply.type() != QDBusMessage::ReplyMessage)
+        qCWarning(lcPositioningd) << method << reply.errorName() << reply.errorMessage();
+    return reply;
+}
+
+Positioningd::Positioningd(QObject *parent) : QObject(parent)
+{
+    // Qt Mobility's names, a UUID each (a bus name element can't start with a digit).
+    const QString id = QLatin1Char('I') + QUuid::createUuid().toString(QUuid::Id128);
+    m_service = QStringLiteral("com.nokia.qlocation.") + id;
+    m_path = QStringLiteral("/com/nokia/qlocation/") + id;
+    QDBusConnection bus = QDBusConnection::sessionBus();
+    if (!bus.registerObject(m_path, this, QDBusConnection::ExportAllSlots)
+            || !bus.registerService(m_service)) {
+        qCWarning(lcPositioningd) << "cannot register" << m_service << bus.lastError().message();
+        return;
+    }
+    auto *watcher = new QDBusServiceWatcher(Daemon, bus, QDBusServiceWatcher::WatchForRegistration, this);
+    connect(watcher, &QDBusServiceWatcher::serviceRegistered, this, [this] {
+        if (registerListener())
+            emit restarted();
+    });
+    registerListener();
+}
+
+Positioningd::~Positioningd()
+{
+    QDBusConnection bus = QDBusConnection::sessionBus();
+    bus.unregisterService(m_service);
+    bus.unregisterObject(m_path);
+}
+
+bool Positioningd::registerListener()
+{
+    const QDBusMessage reply = callDaemon(QStringLiteral("registerListener"), {m_service, m_path});
+    const QVariantList args = reply.arguments();
+    registered = reply.type() == QDBusMessage::ReplyMessage && args.size() == 3;
+    accessDenied = reply.errorName() == QLatin1String("org.freedesktop.DBus.Error.AccessDenied");
+    if (registered) {
+        m_id = args.at(0).toInt();
+        methods = args.at(1).toUInt();
+        minimumInterval = args.at(2).toInt();
+        m_daemon = reply.service();
+    }
+    return registered;
+}
+
+bool Positioningd::configure(int command, int method, int interval)
+{
+    return registered && callDaemon(QStringLiteral("configSession"), {m_id, command, method, interval})
+            .type() == QDBusMessage::ReplyMessage;
+}
+
+QGeoPositionInfo Positioningd::latestPosition(bool satelliteOnly)
+{
+    const QDBusMessage reply = callDaemon(QStringLiteral("latestPosition"), {satelliteOnly});
+    return positionInfo(reply.arguments().value(0).toByteArray());
+}
+
+// Our bus name is no secret: only take updates from the daemon we registered with.
+bool Positioningd::fromDaemon() const
+{
+    return calledFromDBus() && message().service() == m_daemon;
+}
+
+void Positioningd::positionUpdate(const QByteArray &update)
+{
+    if (fromDaemon())
+        emit position(positionInfo(update));
+}
+
+void Positioningd::satellitesInViewUpdate(const QByteArray &update)
+{
+    if (fromDaemon())
+        emit satellitesInView(satellites(update));
+}
+
+void Positioningd::satellitesInUseUpdate(const QByteArray &update)
+{
+    if (fromDaemon())
+        emit satellitesInUse(satellites(update));
+}
+
+void Positioningd::currentSettings(quint32 newMethods, quint32 interval)
+{
+    if (!fromDaemon())
+        return;
+    methods = newMethods;
+    minimumInterval = int(interval);
+    emit settingsChanged();
+}
+
+QGeoPositionInfoSourcePositioningd::QGeoPositionInfoSourcePositioningd(QObject *parent)
+    : QGeoPositionInfoSource(parent), m_daemon(new Positioningd(this))
+{
+    m_requestTimer.setSingleShot(true);
+    connect(&m_requestTimer, &QTimer::timeout, this, [this] {
+        finishRequest();
+        emit updateTimeout();
+    });
+    connect(m_daemon, &Positioningd::position, this, &QGeoPositionInfoSourcePositioningd::newPosition);
+    connect(m_daemon, &Positioningd::settingsChanged,
+            this, &QGeoPositionInfoSource::supportedPositioningMethodsChanged);
+    connect(m_daemon, &Positioningd::restarted, this, [this] {
+        m_error = NoError;
+        int command = Positioningd::SetMethods | Positioningd::SetInterval;
+        if (m_running || m_requestTimer.isActive())
+            command |= Positioningd::Start;
+        m_daemon->configure(command, int(preferredPositioningMethods()),
+                            qMax(updateInterval(), minimumUpdateInterval()));
+    });
+    m_error = m_daemon->registered ? NoError : m_daemon->accessDenied ? AccessError : UnknownSourceError;
+}
+
+QGeoPositionInfoSourcePositioningd::~QGeoPositionInfoSourcePositioningd()
+{
+    if (m_running || m_requestTimer.isActive())
+        m_daemon->configure(Positioningd::Stop);
+}
+
+void QGeoPositionInfoSourcePositioningd::setUpdateInterval(int msec)
+{
+    msec = qMax(msec, minimumUpdateInterval());
+    QGeoPositionInfoSource::setUpdateInterval(msec);
+    m_daemon->configure(Positioningd::SetInterval, 0, msec);
+}
+
+void QGeoPositionInfoSourcePositioningd::setPreferredPositioningMethods(PositioningMethods methods)
+{
+    QGeoPositionInfoSource::setPreferredPositioningMethods(methods);
+    m_daemon->configure(Positioningd::SetMethods, int(preferredPositioningMethods()));
+}
+
+QGeoPositionInfo QGeoPositionInfoSourcePositioningd::lastKnownPosition(bool fromSatellitePositioningMethodsOnly) const
+{
+    return m_daemon->latestPosition(fromSatellitePositioningMethodsOnly);
+}
+
+QGeoPositionInfoSource::PositioningMethods QGeoPositionInfoSourcePositioningd::supportedPositioningMethods() const
+{
+    return PositioningMethods(int(m_daemon->methods));
+}
+
+int QGeoPositionInfoSourcePositioningd::minimumUpdateInterval() const
+{
+    return m_daemon->minimumInterval;
+}
+
+QGeoPositionInfoSource::Error QGeoPositionInfoSourcePositioningd::error() const
+{
+    return m_error;
+}
+
+bool QGeoPositionInfoSourcePositioningd::available()
+{
+    if (m_error != NoError)
+        emit QGeoPositionInfoSource::error(m_error);
+    return m_error == NoError;
+}
+
+void QGeoPositionInfoSourcePositioningd::startUpdates()
+{
+    if (m_running || !available())
+        return;
+    m_running = true;
+    m_lostFix = false;
+    if (!m_requestTimer.isActive())
+        m_daemon->configure(Positioningd::Start);
+}
+
+void QGeoPositionInfoSourcePositioningd::stopUpdates()
+{
+    if (!m_running)
+        return;
+    m_running = false;
+    if (!m_requestTimer.isActive())
+        m_daemon->configure(Positioningd::Stop);
+}
+
+void QGeoPositionInfoSourcePositioningd::requestUpdate(int timeout)
+{
+    if (timeout != 0 && timeout < minimumUpdateInterval()) {
+        emit updateTimeout();
+        return;
+    }
+    if (!available())
+        return;
+    if (!m_requestTimer.isActive()) {
+        // The first fix at the fastest rate, not after the session's interval (Qt Mobility).
+        if (updateInterval() > minimumUpdateInterval())
+            m_daemon->configure(Positioningd::SetInterval, 0, minimumUpdateInterval());
+        if (!m_running)
+            m_daemon->configure(Positioningd::Start);
+    }
+    m_requestTimer.start(timeout ? timeout : DefaultTimeout);
+}
+
+void QGeoPositionInfoSourcePositioningd::finishRequest()
+{
+    m_requestTimer.stop();
+    if (!m_running)
+        m_daemon->configure(Positioningd::Stop);
+    if (updateInterval() > minimumUpdateInterval())
+        m_daemon->configure(Positioningd::SetInterval, 0, updateInterval());
+}
+
+void QGeoPositionInfoSourcePositioningd::newPosition(const QGeoPositionInfo &update)
+{
+    if (!m_running && !m_requestTimer.isActive())
+        return;
+    if (!update.isValid()) {
+        // positioningd lost the fix (Qt Mobility's reading): once, until updates come back.
+        if (m_running && !m_requestTimer.isActive() && !m_lostFix) {
+            m_lostFix = true;
+            emit updateTimeout();
+        }
+        return;
+    }
+    m_lostFix = false;
+    if (m_requestTimer.isActive())
+        finishRequest();
+    emit positionUpdated(update);
+}
+
+QGeoSatelliteInfoSourcePositioningd::QGeoSatelliteInfoSourcePositioningd(QObject *parent)
+    : QGeoSatelliteInfoSource(parent), m_daemon(new Positioningd(this))
+{
+    m_requestTimer.setSingleShot(true);
+    connect(&m_requestTimer, &QTimer::timeout, this, [this] {
+        finishRequest();
+        emit requestTimeout();
+    });
+    connect(m_daemon, &Positioningd::satellitesInView, this, [this](const QList<QGeoSatelliteInfo> &s) {
+        if (!m_running && !m_requestTimer.isActive())
+            return;
+        emit satellitesInViewUpdated(s);
+        // A second list in view without one in use: none in use to wait for (Qt Mobility).
+        if (m_requestTimer.isActive() && m_seenInView)
+            finishRequest();
+        m_seenInView = true;
+    });
+    connect(m_daemon, &Positioningd::satellitesInUse, this, [this](const QList<QGeoSatelliteInfo> &s) {
+        if (!m_running && !m_requestTimer.isActive())
+            return;
+        emit satellitesInUseUpdated(s);
+        if (m_requestTimer.isActive())
+            finishRequest();
+    });
+    connect(m_daemon, &Positioningd::restarted, this, [this] {
+        m_error = NoError;
+        if (m_running || m_requestTimer.isActive())
+            m_daemon->configure(Positioningd::SatStart);
+    });
+    m_error = m_daemon->registered ? NoError : m_daemon->accessDenied ? AccessError : UnknownSourceError;
+}
+
+QGeoSatelliteInfoSourcePositioningd::~QGeoSatelliteInfoSourcePositioningd()
+{
+    if (m_running || m_requestTimer.isActive())
+        m_daemon->configure(Positioningd::SatStop);
+}
+
+int QGeoSatelliteInfoSourcePositioningd::minimumUpdateInterval() const
+{
+    return m_daemon->minimumInterval;
+}
+
+QGeoSatelliteInfoSource::Error QGeoSatelliteInfoSourcePositioningd::error() const
+{
+    return m_error;
+}
+
+bool QGeoSatelliteInfoSourcePositioningd::available()
+{
+    if (m_error != NoError)
+        emit QGeoSatelliteInfoSource::error(m_error);
+    return m_error == NoError;
+}
+
+void QGeoSatelliteInfoSourcePositioningd::startUpdates()
+{
+    if (m_running || !available())
+        return;
+    m_running = true;
+    if (!m_requestTimer.isActive())
+        m_daemon->configure(Positioningd::SatStart);
+}
+
+void QGeoSatelliteInfoSourcePositioningd::stopUpdates()
+{
+    if (!m_running)
+        return;
+    m_running = false;
+    if (!m_requestTimer.isActive())
+        m_daemon->configure(Positioningd::SatStop);
+}
+
+void QGeoSatelliteInfoSourcePositioningd::requestUpdate(int timeout)
+{
+    if (timeout != 0 && timeout < minimumUpdateInterval()) {
+        emit requestTimeout();
+        return;
+    }
+    if (!available())
+        return;
+    if (!m_running && !m_requestTimer.isActive())
+        m_daemon->configure(Positioningd::SatStart);
+    m_seenInView = false;
+    m_requestTimer.start(timeout ? timeout : DefaultTimeout);
+}
+
+void QGeoSatelliteInfoSourcePositioningd::finishRequest()
+{
+    m_requestTimer.stop();
+    if (!m_running)
+        m_daemon->configure(Positioningd::SatStop);
+}
+
+QGeoPositionInfoSource *QGeoPositionInfoSourceFactoryPositioningd::positionInfoSource(QObject *parent)
+{
+    return new QGeoPositionInfoSourcePositioningd(parent);
+}
+
+QGeoSatelliteInfoSource *QGeoPositionInfoSourceFactoryPositioningd::satelliteInfoSource(QObject *parent)
+{
+    return new QGeoSatelliteInfoSourcePositioningd(parent);
+}
+
+QGeoAreaMonitorSource *QGeoPositionInfoSourceFactoryPositioningd::areaMonitor(QObject *parent)
+{
+    Q_UNUSED(parent);
+    return nullptr; // the positionpoll plugin's, on top of our positions
+}
+
+QT_END_NAMESPACE
