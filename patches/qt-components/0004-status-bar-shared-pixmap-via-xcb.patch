+#include "mdeclarativestatusbar.h"
+
+#include "mdeclarativescreen.h"
+#include "mwindowstate.h"
+
+#include <QDBusConnection>
+#include <QDBusMessage>
+#include <QDBusPendingCallWatcher>
+#include <QDBusPendingReply>
+#include <QDBusServiceWatcher>
+#include <QDebug>
+#include <QGuiApplication>
+#include <QMouseEvent>
+#include <QPainter>
+#include <QTimer>
+#include <qpa/qplatformnativeinterface.h>
+
+#include <xcb/xcb.h>
+#include <xcb/damage.h>
+
+static const int STATUSBAR_HEIGHT = 36;
+static const char statusBarService[] = "com.meego.core.MStatusBar";
+static const char statusBarPath[] = "/statusbar";
+static const char menuService[] = "com.meego.core.MStatusIndicatorMenu";
+static const char menuPath[] = "/statusindicatormenu";
+
+static xcb_connection_t *xcbConnection()
+{
+    return static_cast<xcb_connection_t *>(
+        QGuiApplication::platformNativeInterface()->nativeResourceForIntegration("connection"));
+}
+
+// The damage extension's first event number, 0 without it. Asks for the version once, which
+// the protocol requires before any other damage request.
+static int damageFirstEvent()
+{
+    static int first = -1;
+    if (first < 0) {
+        first = 0;
+        xcb_connection_t *c = xcbConnection();
+        const xcb_query_extension_reply_t *ext = c ? xcb_get_extension_data(c, &xcb_damage_id) : nullptr;
+        if (ext && ext->present) {
+            free(xcb_damage_query_version_reply(
+                c, xcb_damage_query_version(c, XCB_DAMAGE_MAJOR_VERSION, XCB_DAMAGE_MINOR_VERSION), nullptr));
+            first = ext->first_event;
+        }
+    }
+    return first;
+}
+
+MDeclarativeStatusBar::MDeclarativeStatusBar(QQuickItem *parent)
+    : QQuickPaintedItem(parent)
+    , m_orientation(MDeclarativeScreen::Portrait)
+{
+    setAcceptedMouseButtons(Qt::LeftButton);
+    setZ(1010); // above the title bar, as in Qt 4
+    setImplicitHeight(STATUSBAR_HEIGHT);
+    qApp->installNativeEventFilter(this);
+
+    auto *watcher = new QDBusServiceWatcher(QLatin1String(statusBarService), QDBusConnection::sessionBus(),
+                                            QDBusServiceWatcher::WatchForRegistration
+                                                | QDBusServiceWatcher::WatchForUnregistration,
+                                            this);
+    connect(watcher, &QDBusServiceWatcher::serviceRegistered, this, &MDeclarativeStatusBar::queryPixmap);
+    connect(watcher, &QDBusServiceWatcher::serviceUnregistered, this, [this] { setDamage(false); });
+    connect(MWindowState::instance(), &MWindowState::activeChanged,
+            this, &MDeclarativeStatusBar::updateDamageSubscription);
+    connect(this, &QQuickItem::visibleChanged, this, &MDeclarativeStatusBar::updateDamageSubscription);
+    queryPixmap();
+}
+
+MDeclarativeStatusBar::~MDeclarativeStatusBar()
+{
+    qApp->removeNativeEventFilter(this);
+    setDamage(false);
+}
+
+void MDeclarativeStatusBar::queryPixmap()
+{
+    const QDBusMessage message = QDBusMessage::createMethodCall(QLatin1String(statusBarService),
+                                                                QLatin1String(statusBarPath),
+                                                                QLatin1String(statusBarService),
+                                                                QStringLiteral("sharedPixmapHandle"));
+    auto *watcher = new QDBusPendingCallWatcher(QDBusConnection::sessionBus().asyncCall(message), this);
+    connect(watcher, &QDBusPendingCallWatcher::finished, this, &MDeclarativeStatusBar::pixmapReceived);
+}
+
+void MDeclarativeStatusBar::pixmapReceived(QDBusPendingCallWatcher *call)
+{
+    call->deleteLater();
+    const bool hadPixmap = hasPixmap();
+    const QDBusPendingReply<quint32> reply = *call;
+    setDamage(false);
+    if (reply.isError()) {
+        qWarning() << "MDeclarativeStatusBar:" << reply.error().message();
+        m_pixmap = 0;
+    } else {
+        m_pixmap = reply.value();
+    }
+    grab();
+    updateDamageSubscription();
+    update();
+    if (hasPixmap() != hadPixmap)
+        emit hasPixmapChanged();
+}
+
+// Copies the pixmap's current contents; 854x72 at most, so a round trip is cheap enough.
+void MDeclarativeStatusBar::grab()
+{
+    m_image = QImage();
+    xcb_connection_t *c = xcbConnection();
+    if (!c || !m_pixmap)
+        return;
+    xcb_get_geometry_reply_t *geometry = xcb_get_geometry_reply(c, xcb_get_geometry(c, m_pixmap), nullptr);
+    if (!geometry)
+        return;
+    const int w = geometry->width;
+    const int h = geometry->height;
+    const int depth = geometry->depth;
+    free(geometry);
+    xcb_get_image_reply_t *image = xcb_get_image_reply(
+        c, xcb_get_image(c, XCB_IMAGE_FORMAT_Z_PIXMAP, m_pixmap, 0, 0, w, h, ~0u), nullptr);
+    if (!image)
+        return;
+    const QImage::Format format = depth == 16 ? QImage::Format_RGB16
+                                : depth == 32 ? QImage::Format_ARGB32_Premultiplied
+                                              : QImage::Format_RGB32;
+    if (h > 0)
+        m_image = QImage(xcb_get_image_data(image), w, h, xcb_get_image_data_length(image) / h, format).copy();
+    free(image);
+    setImplicitWidth(w);
+}
+
+void MDeclarativeStatusBar::updateDamageSubscription()
+{
+    // Pixmap changes only matter while the app is in front and the bar is shown.
+    setDamage(m_pixmap && isVisible() && MWindowState::instance()->active());
+}
+
+void MDeclarativeStatusBar::setDamage(bool on)
+{
+    xcb_connection_t *c = xcbConnection();
+    if (!c || !damageFirstEvent())
+        return;
+    if (on && !m_damage) {
+        m_damage = xcb_generate_id(c);
+        xcb_damage_create(c, m_damage, m_pixmap, XCB_DAMAGE_REPORT_LEVEL_NON_EMPTY);
+        grab(); // catch up with what changed while nobody listened
+        update();
+    } else if (!on && m_damage) {
+        xcb_damage_destroy(c, m_damage);
+        m_damage = 0;
+    }
+    xcb_flush(c);
+}
+
+bool MDeclarativeStatusBar::nativeEventFilter(const QByteArray &eventType, void *message, long *)
+{
+    if (!m_damage || eventType != "xcb_generic_event_t")
+        return false;
+    auto *event = static_cast<xcb_generic_event_t *>(message);
+    if ((event->response_type & 0x7f) != damageFirstEvent() + XCB_DAMAGE_NOTIFY)
+        return false;
+    if (reinterpret_cast<xcb_damage_notify_event_t *>(event)->damage != m_damage)
+        return false;
+    // Subtracting re-arms the "non-empty" report for the next change.
+    xcb_damage_subtract(xcbConnection(), m_damage, XCB_NONE, XCB_NONE);
+    grab();
+    update();
+    return true;
+}
+
+void MDeclarativeStatusBar::paint(QPainter *painter)
+{
+    const QRectF target(0, 0, width(), height());
+    if (m_image.isNull()) {
+        painter->fillRect(target, Qt::black);
+        return;
+    }
+    const bool landscape = m_orientation == MDeclarativeScreen::Landscape
+                        || m_orientation == MDeclarativeScreen::LandscapeInverted;
+    painter->drawImage(target, m_image, QRectF(0, landscape ? 0 : height(), width(), height()));
+    if (m_pressed || m_feedback)
+        painter->fillRect(target, QColor(0, 0, 0, 153)); // black at 0.6, as in Qt 4
+}
+
+void MDeclarativeStatusBar::setOrientation(int orientation)
+{
+    if (m_orientation == orientation)
+        return;
+    m_orientation = orientation;
+    update();
+    emit orientationChanged();
+}
+
+void MDeclarativeStatusBar::mousePressEvent(QMouseEvent *event)
+{
+    m_pressed = true;
+    // The top edge also starts the compositor's swipe, so press and release can come right
+    // after each other: keep the feedback up long enough to be seen (as in Qt 4).
+    m_feedback = true;
+    QTimer::singleShot(200, this, [this] {
+        m_feedback = false;
+        update();
+    });
+    update();
+    event->accept();
+}
+
+void MDeclarativeStatusBar::mouseReleaseEvent(QMouseEvent *event)
+{
+    if (!m_pressed)
+        return;
+    m_pressed = false;
+    update();
+    if (QRectF(0, 0, width(), height()).adjusted(-30, -30, 30, 30).contains(event->localPos())) {
+        const QDBusMessage message = QDBusMessage::createMethodCall(QLatin1String(menuService),
+                                                                    QLatin1String(menuPath),
+                                                                    QLatin1String(menuService),
+                                                                    QStringLiteral("open"));
+        QDBusConnection::sessionBus().asyncCall(message);
+    }
+}
