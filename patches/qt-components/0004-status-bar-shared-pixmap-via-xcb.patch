+#ifndef MDECLARATIVESTATUSBAR_H
+#define MDECLARATIVESTATUSBAR_H
+
+#include <QtCore/QAbstractNativeEventFilter>
+#include <QtGui/QImage>
+#include <QtQuick/QQuickPaintedItem>
+
+class QDBusPendingCallWatcher;
+
+// Draws the shared X pixmap that the system status bar (com.meego.core.MStatusBar) renders
+// into: landscape in rows 0-35, portrait in rows 36-71. Repaints when XDamage reports a
+// change, while the app is active and the bar visible; a tap opens the status menu. Qt 4
+// used QPixmap::fromX11Pixmap, which Qt 5 lacks, so this reads the pixmap through xcb.
+class MDeclarativeStatusBar : public QQuickPaintedItem, public QAbstractNativeEventFilter
+{
+    Q_OBJECT
+    Q_PROPERTY(int orientation READ orientation WRITE setOrientation NOTIFY orientationChanged)
+    Q_PROPERTY(bool hasPixmap READ hasPixmap NOTIFY hasPixmapChanged)
+
+public:
+    explicit MDeclarativeStatusBar(QQuickItem *parent = nullptr);
+    ~MDeclarativeStatusBar() override;
+
+    void paint(QPainter *painter) override;
+    bool nativeEventFilter(const QByteArray &eventType, void *message, long *result) override;
+
+    int orientation() const { return m_orientation; } // MDeclarativeScreen::Orientation
+    void setOrientation(int orientation);
+    bool hasPixmap() const { return m_pixmap != 0; }
+
+signals:
+    void orientationChanged();
+    void hasPixmapChanged();
+
+protected:
+    void mousePressEvent(QMouseEvent *event) override;
+    void mouseReleaseEvent(QMouseEvent *event) override;
+
+private slots:
+    void queryPixmap();
+    void pixmapReceived(QDBusPendingCallWatcher *call);
+    void updateDamageSubscription();
+
+private:
+    void grab();
+    void setDamage(bool on);
+
+    quint32 m_pixmap = 0;
+    quint32 m_damage = 0;
+    int m_orientation;
+    QImage m_image;
+    bool m_pressed = false;
+    bool m_feedback = false;
+};
+
+#endif
