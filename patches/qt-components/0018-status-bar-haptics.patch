+// Haptics and sound through meegofeedbackd, as the Qt 4 status bar did (libmeegotouch's
+// MFeedbackPlayer protocol): a QDataStream of QStrings, the protocol version and the app's name
+// on connecting, then one effect name per playback. A local connect completes at once, so the
+// greeting goes out before the first effect; without the daemon nothing plays.
+static void playFeedback(const QString &effect)
+{
+    static QLocalSocket *socket = nullptr;
+    if (!socket) {
+        socket = new QLocalSocket(qApp);
+        QObject::connect(socket, &QLocalSocket::connected, [] {
+            QDataStream out(socket);
+            out << QStringLiteral("FeedbackProtocolVersion#1") << QCoreApplication::applicationName();
+        });
+    }
+    if (socket->state() == QLocalSocket::UnconnectedState)
+        socket->connectToServer(QStringLiteral("/tmp/mfeedbackd/player.sock"));
+    if (socket->state() == QLocalSocket::ConnectedState) {
+        QDataStream out(socket);
+        out << effect;
+        socket->flush();
+    }
+}
