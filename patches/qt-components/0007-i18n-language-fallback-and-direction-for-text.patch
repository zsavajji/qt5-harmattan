--- a/src/meego/i18n/mlocalewrapper.h	2026-09-26 17:26:13
+++ b/src/meego/i18n/mlocalewrapper.h	2026-09-26 17:26:13
@@ -170,6 +170,8 @@
     // someone used it outside QML...
 #ifndef HAVE_MEEGOTOUCH
     QString language() const { return QString(); }
+    // qt5-harmattan: TextField and TextArea call it on double click (Qt::LayoutDirection)
+    Q_INVOKABLE int directionForText(const QString &text) const { return text.isRightToLeft() ? Qt::RightToLeft : Qt::LeftToRight; }
 #else // HAVE_MEEGOTOUCH
 
 
